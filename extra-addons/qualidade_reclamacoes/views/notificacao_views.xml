<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Qualidade → Configuração → Responsáveis e notificações: 3 linhas fixas -->
    <record id="view_qualidade_notificacao_config_list" model="ir.ui.view">
      <field name="name">qualidade.notificacao.config.list</field>
      <field name="model">qualidade.notificacao.config</field>
      <field name="arch" type="xml">
        <list editable="bottom" create="0" delete="0">
          <field name="nome"/>
          <field name="ativo" widget="boolean_toggle"/>
          <field name="responsavel_id" options="{'no_create': True, 'no_open': True}" required="ativo"/>
          <field name="informado_ids" widget="many2many_tags" options="{'no_create': True}"/>
          <field name="prazo_dias"/>
        </list>
      </field>
    </record>

    <record id="action_qualidade_notificacao_config" model="ir.actions.act_window">
      <field name="name">Responsáveis e notificações</field>
      <field name="res_model">qualidade.notificacao.config</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="view_qualidade_notificacao_config_list"/>
    </record>

    <!-- Link "Abrir no Responder" das notificações: abre a janela do Responder por cima da lista da Qualidade -->
    <record id="action_abrir_responder_cliente" model="ir.actions.server">
      <field name="name">Abrir no Responder</field>
      <field name="model_id" ref="formularios.model_form_reclama_cliente"/>
      <field name="state">code</field>
      <field name="groups_id" eval="[(4, ref('qualidade_reclamacoes.group_qualidade_eng'))]"/>
      <field name="code">action = env['form.reclama.cliente'].browse(env.context.get('active_id')).exists().action_responder_cliente()</field>
    </record>
    <record id="action_abrir_responder_fornecedor" model="ir.actions.server">
      <field name="name">Abrir no Responder</field>
      <field name="model_id" ref="formularios.model_form_reclama_fornecedor"/>
      <field name="state">code</field>
      <field name="groups_id" eval="[(4, ref('qualidade_reclamacoes.group_qualidade_eng'))]"/>
      <field name="code">action = env['form.reclama.fornecedor'].browse(env.context.get('active_id')).exists().action_responder_fornecedor()</field>
    </record>

    <!-- Quem chega à ficha da reclamação (nome no menu das atividades): Responder a 1 clique -->
    <record id="view_form_reclama_cliente_responder" model="ir.ui.view">
      <field name="name">form.reclama.cliente.form.responder</field>
      <field name="model">form.reclama.cliente</field>
      <field name="inherit_id" ref="formularios.view_form_reclama_cliente_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
          <button name="action_responder_cliente" type="object" string="Responder" class="btn-primary"
                  invisible="not id" groups="qualidade_reclamacoes.group_qualidade_eng"/>
        </xpath>
      </field>
    </record>
    <record id="view_form_reclama_fornecedor_responder" model="ir.ui.view">
      <field name="name">form.reclama.fornecedor.form.responder</field>
      <field name="model">form.reclama.fornecedor</field>
      <field name="inherit_id" ref="formularios.view_form_reclama_fornecedor_form"/>
      <field name="arch" type="xml">
        <xpath expr="//header" position="inside">
          <button name="action_responder_fornecedor" type="object" string="Responder" class="btn-primary"
                  invisible="not id" groups="qualidade_reclamacoes.group_qualidade_eng"/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
