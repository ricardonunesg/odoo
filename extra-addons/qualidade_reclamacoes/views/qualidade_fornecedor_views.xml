<odoo>
  <data>

    <record id="view_resposta_fornecedor_form" model="ir.ui.view">
      <field name="name">qualidade.resposta.fornecedor.form</field>
      <field name="model">qualidade.resposta.fornecedor</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <div class="oe_title">
              <h1 invisible="tipo_reclamacao == 'interna'">Resposta Qualidade - Fornecedor</h1>
              <h1 invisible="tipo_reclamacao != 'interna'">Resposta Qualidade - Interna</h1>
            </div>

            <group>
              <!-- a resposta fica sempre na reclamação do Responder: só de leitura, sem abrir nem escolher outra -->
              <field name="reclamacao_id" readonly="1" force_save="1" options="{'no_open': True, 'no_create': True}"/>
              <field name="pdf_reclamacao_url" widget="url" text="Imprimir PDF da reclamação" readonly="1" invisible="not reclamacao_id"/>
              <field name="estado_resposta"/>
              <field name="data"/>
            </group>

            <group string="Dados do Formulário">
              <field name="utilizador_id" readonly="1"/>
              <field name="armazem" readonly="1"/>
              <field name="tipo_reclamacao" readonly="1"/>
              <field name="fornecedor" readonly="1" invisible="tipo_reclamacao == 'interna'"/>
              <field name="instalacao_reclamada" readonly="1" invisible="tipo_reclamacao != 'interna'"/>
              <field name="descricao_reclamacao" readonly="1"/>
              <field name="anexos_formulario_ids" widget="qualidade_anexos_preview" readonly="1"/>
            </group>

            <group string="Artigos da Reclamação">
              <field name="linha_ids" nolabel="1" readonly="1">
                <list>
                  <field name="codigo_artigo"/>
                  <field name="descricao_artigo"/>
                  <field name="lote_guia_fatura"/>
                </list>
              </field>
            </group>

            <group string="Resposta da Qualidade">
              <field name="causa"/>
              <field name="acoes_correcao"/>
              <field name="acoes_corretivas"/>
              <div class="o_form_label">(corrigem origem do problema)</div>
              <field name="categoria"/>
              <field name="origem"/>
              <field name="gravidade"/>
              <field name="responsavel_id"/>
              <field name="aprovado_por_id"/>
              <field name="data_conclusao"/>
              <field name="verificacao_eficacia"/>
              <field name="data_fecho"/>
              <field name="observacoes"/>
            </group>

            <group string="Evidências / Anexos">
              <field name="anexos_ids" widget="qualidade_anexos_preview"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_responder_fornecedor" model="ir.actions.act_window">
      <field name="name">Responder (Fornecedor)</field>
      <field name="res_model">qualidade.resposta.fornecedor</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_resposta_fornecedor_form"/>
      <field name="target">new</field>
      <field name="context">{'default_reclamacao_id': active_id}</field>
    </record>

    <record id="view_qualidade_fornecedor_list" model="ir.ui.view">
      <field name="name">qualidade.form.reclama.fornecedor.list</field>
      <field name="model">form.reclama.fornecedor</field>
      <field name="arch" type="xml">
        <list>
          <field name="name" string="Número"/>
          <field name="numeros_anteriores" optional="hide"/>
          <field name="create_date" string="Criado em" optional="show"/>
          <field name="fornecedor" optional="show"/>
          <field name="artigos_codigo" optional="show"/>
          <field name="artigos_descricao" optional="show"/>
          <field name="artigos_lote" optional="show"/>
          <field name="ultima_resposta_estado" string="Estado" widget="badge" optional="show"
                 decoration-danger="ultima_resposta_estado == 'aberto'"
                 decoration-warning="ultima_resposta_estado == 'pendente'"
                 decoration-success="ultima_resposta_estado == 'fechado'"/>
          <field name="ultima_categoria" optional="hide"/>
          <field name="ultima_origem" optional="show"/>
          <field name="ultima_gravidade" optional="hide"/>
          <field name="ultima_responsavel_id" optional="hide"/>
          <field name="ultima_aprovado_por_id" optional="hide"/>
          <field name="ultima_data_conclusao" optional="hide"/>
          <field name="ultima_causa" optional="hide"/>
          <field name="ultima_acoes_corretivas" optional="hide"/>
          <field name="ultima_verificacao_eficacia" optional="hide"/>
          <field name="ultima_data_fecho" optional="hide"/>
          <field name="ultima_observacoes" optional="hide"/>
          <button name="action_responder_fornecedor" type="object" string="Responder" class="btn-primary"/>
        </list>
      </field>
    </record>

    <record id="view_qualidade_fornecedor_search" model="ir.ui.view">
      <field name="name">qualidade.form.reclama.fornecedor.search</field>
      <field name="model">form.reclama.fornecedor</field>
      <field name="arch" type="xml">
        <search>
          <!-- o número procura também nos números anteriores (correcções de tipo) -->
          <field name="name" string="Número" filter_domain="['|', ('name', 'ilike', self), ('numeros_anteriores', 'ilike', self)]"/>
          <field name="fornecedor"/>
          <!-- artigo e lote: procuram em todas as linhas da reclamação e nos campos antigos de artigo único -->
          <field name="codigo_artigo" string="Artigo" filter_domain="['|', '|', '|', ('linha_ids.codigo_artigo', 'ilike', self), ('linha_ids.descricao_artigo', 'ilike', self), ('codigo_artigo', 'ilike', self), ('descricao_artigo', 'ilike', self)]"/>
          <field name="lote_guia_fatura" string="Lote / Guia / Fatura" filter_domain="['|', ('linha_ids.lote_guia_fatura', 'ilike', self), ('lote_guia_fatura', 'ilike', self)]"/>
          <field name="ultima_responsavel_id" string="Responsável"/>
          <filter name="sem_resposta" string="Sem Resposta" domain="[('ultima_resposta_estado', '=', False)]"/>
          <filter name="aberto" string="Aberto" domain="[('ultima_resposta_estado', '=', 'aberto')]"/>
          <filter name="pendente" string="Pendente" domain="[('ultima_resposta_estado', '=', 'pendente')]"/>
          <filter name="fechado" string="Fechado" domain="[('ultima_resposta_estado', '=', 'fechado')]"/>
          <separator/>
          <filter name="gravidade_baixa" string="Gravidade Baixa" domain="[('ultima_gravidade', '=', 'baixa')]"/>
          <filter name="gravidade_media" string="Gravidade Média" domain="[('ultima_gravidade', '=', 'media')]"/>
          <filter name="gravidade_alta" string="Gravidade Alta" domain="[('ultima_gravidade', '=', 'alta')]"/>
          <filter name="gravidade_critica" string="Gravidade Crítica" domain="[('ultima_gravidade', '=', 'critica')]"/>
          <separator/>
          <filter name="categoria_qualidade" string="Categoria Qualidade" domain="[('ultima_categoria', '=', 'qualidade')]"/>
          <filter name="categoria_seguranca" string="Categoria Segurança" domain="[('ultima_categoria', '=', 'seguranca')]"/>
          <filter name="categoria_servico" string="Categoria Serviço (Transporte)" domain="[('ultima_categoria', '=', 'servico')]"/>
          <separator/>
          <filter name="as_minhas" string="As minhas (responsável)" domain="[('ultima_responsavel_id', '=', uid)]"/>
          <separator/>
          <filter name="data_criacao" string="Data de criação" date="create_date"/>
          <filter name="data_conclusao" string="Data de conclusão" date="ultima_data_conclusao"/>
          <filter name="data_fecho" string="Data de fecho" date="ultima_data_fecho"/>
          <group expand="0" string="Agrupar por">
            <filter name="agrupar_estado" string="Estado" context="{'group_by': 'ultima_resposta_estado'}"/>
            <filter name="agrupar_gravidade" string="Gravidade" context="{'group_by': 'ultima_gravidade'}"/>
            <filter name="agrupar_categoria" string="Categoria" context="{'group_by': 'ultima_categoria'}"/>
            <filter name="agrupar_responsavel" string="Responsável" context="{'group_by': 'ultima_responsavel_id'}"/>
            <filter name="agrupar_armazem" string="Armazém" context="{'group_by': 'armazem'}"/>
            <filter name="agrupar_mes" string="Mês" context="{'group_by': 'create_date:month'}"/>
            <filter name="agrupar_trimestre" string="Trimestre" context="{'group_by': 'create_date:quarter'}"/>
            <filter name="agrupar_ano" string="Ano" context="{'group_by': 'create_date:year'}"/>
          </group>
        </search>
      </field>
    </record>

    <record id="action_qualidade_fornecedor" model="ir.actions.act_window">
      <field name="name">Reclamações Fornecedores</field>
      <field name="res_model">form.reclama.fornecedor</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="view_qualidade_fornecedor_list"/>
      <field name="search_view_id" ref="view_qualidade_fornecedor_search"/>
      <field name="domain">[('tipo_reclamacao', '!=', 'interna')]</field>
    </record>

    <!-- Reclamações internas (ex.: Arruda reclama a Tomar): mesmo modelo, mesma lista e mesma resposta -->
    <record id="action_qualidade_interna" model="ir.actions.act_window">
      <field name="name">Reclamações Internas</field>
      <field name="res_model">form.reclama.fornecedor</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="view_qualidade_fornecedor_list"/>
      <field name="search_view_id" ref="view_qualidade_fornecedor_search"/>
      <field name="domain">[('tipo_reclamacao', '=', 'interna')]</field>
    </record>

  </data>
</odoo>
