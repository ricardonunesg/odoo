    <record id="preset_tempero" model="certificado.organoletica.preset">
        <field name="name">Tempero Alimentar (EN)</field>
        <field name="sequence">60</field>
    </record>
    <record id="preset_tempero_l1" model="certificado.organoletica.preset.linha">
        <field name="preset_id" ref="preset_tempero"/>
        <field name="sequence">10</field>
        <field name="caracteristica">Appearance</field>
        <field name="valor">Clear liquid without deposit</field>
    </record>
    <record id="preset_tempero_l2" model="certificado.organoletica.preset.linha">
        <field name="preset_id" ref="preset_tempero"/>
        <field name="sequence">20</field>
        <field name="caracteristica">Color</field>
        <field name="valor">Yellow Greenish</field>
    </record>
    <record id="preset_tempero_l3" model="certificado.organoletica.preset.linha">
        <field name="preset_id" ref="preset_tempero"/>
        <field name="sequence">30</field>
        <field name="caracteristica">Smell</field>
