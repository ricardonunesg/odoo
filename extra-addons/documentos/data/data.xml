    </record>
    <record id="preset_tempero_l4" model="certificado.organoletica.preset.linha">
        <field name="preset_id" ref="preset_tempero"/>
        <field name="sequence">40</field>
        <field name="caracteristica">Flavor</field>
        <field name="valor">Soft</field>
    </record>

    <!-- Templates padrão certificados narrativos -->
    <record id="template_salubridade_standard" model="certificado.salubridade.template">
        <field name="name">Standard PT</field>
        <field name="sequence">10</field>
        <field name="default_morada_id" ref="morada_arruda"/>
        <field name="preset_id" ref="preset_azeite_pt"/>
        <field name="in_english" eval="False"/>
    </record>
    <record id="template_qualidade_standard" model="certificado.qualidade.template">
        <field name="name">Standard EN</field>
        <field name="sequence">10</field>
        <field name="default_morada_id" ref="morada_arruda"/>
        <field name="preset_id" ref="preset_azeite_virgem_extra"/>
        <field name="in_english" eval="True"/>
        <field name="show_tabela_identificacao" eval="False"/>
    </record>

</odoo>
