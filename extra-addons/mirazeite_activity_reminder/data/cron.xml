<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Corre de hora a hora mas só trabalha a partir das 08:00 de Lisboa (assim a
         mudança de hora de verão/inverno não desloca o lembrete). Cada atividade
         fica marcada com a data do lembrete: nunca recebe dois no mesmo dia. -->
    <record id="ir_cron_activity_due_today" model="ir.cron">
        <field name="name">Atividades: lembrete das que têm prazo para hoje (08:00)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">model._mirazeite_cron_due_today_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:00:00')"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
