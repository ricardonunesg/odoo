<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_primavera_sync_log_list" model="ir.ui.view">
        <field name="name">primavera.sync.log.list</field>
        <field name="model">primavera.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_primavera_sync_log_form" model="ir.ui.view">
        <field name="name">primavera.sync.log.form</field>
        <field name="model">primavera.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="create_date"/>
                        <field name="connection_id"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_primavera_sync_log" model="ir.actions.act_window">
        <field name="name">Logs Primavera</field>
        <field name="res_model">primavera.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
