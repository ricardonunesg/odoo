<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_primavera_connector" model="ir.ui.view">
        <field name="name">res.partner.form.primavera.connector</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="primavera_customer_code"/>
                <field name="primavera_supplier_code"/>
            </xpath>
        </field>
    </record>
</odoo>
