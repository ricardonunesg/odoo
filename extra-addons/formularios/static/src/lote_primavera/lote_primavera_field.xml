<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="formularios.LotePrimaveraField">
        <span t-if="props.readonly" t-esc="valor"/>
        <AutoComplete t-else="" id="props.id" class="'o_lote_primavera'" value="valor" sources="fontes"
                      onSelect.bind="escolher" input="input"/>
    </t>

    <t t-name="formularios.LotePrimaveraOpcao">
        <span t-if="option.mensagem" class="text-muted" t-esc="option.label"/>
        <span t-else="" class="o_lote_primavera_opcao">
            <b t-esc="option.lote"/>
            <span t-esc="option.documento"/>
            <span t-esc="option.data"/>
        </span>
    </t>
</templates>
