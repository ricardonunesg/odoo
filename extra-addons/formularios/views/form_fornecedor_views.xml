<odoo>
  <data>
    <record id="view_form_reclama_fornecedor_form" model="ir.ui.view">
      <field name="name">form.reclama.fornecedor.form</field>
      <field name="model">form.reclama.fornecedor</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_imprimir_pdf" type="object" string="Imprimir PDF" class="btn-primary" invisible="not id"/>
            <button name="action_corrigir_tipo" type="object" string="Corrigir tipo" invisible="not id" groups="base.group_system"/>
          </header>
          <sheet>
            <div class="oe_title">
              <h1>
                <field name="name" readonly="1" invisible="not id"/>
                <span invisible="id">Nova reclamação</span>
              </h1>
            </div>
            <group>
              <field name="user_id"/>
              <field name="armazem"/>
              <!-- depois de gravada, o tipo só muda no botão "Corrigir tipo" (administradores) -->
              <field name="tipo_reclamacao" widget="radio" options="{'horizontal': true}" readonly="id"/>
            </group>

            <group string="Numeração anterior" invisible="not numeros_anteriores">
              <field name="numeros_anteriores"/>
              <field name="historico_numeracao"/>
            </group>

            <group>
              <field name="fornecedor_partner_id"
                     invisible="tipo_reclamacao == 'interna'"
                     required="tipo_reclamacao != 'interna'"
                     options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="instalacao_reclamada"
                     invisible="tipo_reclamacao != 'interna'"
                     required="tipo_reclamacao == 'interna'"/>
              <field name="fornecedor" invisible="1"/>
            </group>

            <group string="Artigos da Reclamação">
              <field name="linha_ids" nolabel="1">
                <list editable="bottom">
                  <field name="sequence" widget="handle"/>
                  <field name="artigo_id" options="{'no_create': True, 'no_create_edit': True}"/>
                  <field name="codigo_artigo"/>
                  <field name="descricao_artigo"/>
                  <field name="lote_guia_fatura"/>
                </list>
              </field>
            </group>

            <group>
              <field name="descricao_reclamacao"/>
              <field name="acoes_correcao"/>
              <div class="o_form_label">(Se já houver)</div>
            </group>

            <group string="Documento da Reclamação">
              <div class="o_form_label">(Email do fornecedor, whatsapp, documentos enviados pelo fornecedor, fotos, etc)</div>
              <field name="anexos_ids" widget="many2many_binary"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  </data>
</odoo>
