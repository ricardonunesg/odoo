<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mirazeite_crm_historico_primavera.Historico">
        <div class="o_historico_primavera">
            <t t-set="data" t-value="state.data"/>

            <div t-if="state.loading" class="text-center text-muted py-5">
                <i class="fa fa-circle-o-notch fa-spin me-2"/>A consultar o Primavera…
            </div>

            <div t-elif="data.error" class="alert alert-warning mb-0" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/><t t-esc="data.error"/>
            </div>

            <t t-else="">
                <!-- Cliente e critérios -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <div class="fs-5 fw-bold">
                            <span class="badge text-bg-light border me-2" t-esc="data.customer.code"/>
                            <t t-esc="data.customer.name"/>
                        </div>
                        <div class="small text-muted mt-1">
                            <span t-if="data.customer.vat" class="me-3">NIF <t t-esc="data.customer.vat"/></span>
                            <span t-if="data.customer.nif_validated" class="text-success me-3"
                                  title="O NIF da ficha do Odoo é igual ao NIF do cliente no Primavera">
                                <i class="fa fa-check-circle me-1"/>Correspondência validada por NIF
                            </span>
                            <span t-else="" class="text-warning me-3"
                                  title="Um dos lados não tem NIF válido: a correspondência é só pelo código Primavera">
                                <i class="fa fa-info-circle me-1"/>Correspondência só pelo código
                            </span>
                            <span t-if="data.customer.archived" class="badge text-bg-secondary">Cliente anulado no Primavera</span>
                        </div>
                    </div>
                    <div class="text-end small text-muted">
                        <div><t t-esc="data.period"/> · valores sem IVA · anulados excluídos</div>
                        <div>Faturas <t t-esc="data.doc_types"/> · Notas de crédito <t t-esc="data.credit_types"/></div>
                    </div>
                </div>

                <div t-if="!data.count" class="alert alert-info mb-0">
                    <i class="fa fa-info-circle me-2"/>Sem faturas nem notas de crédito no período.
                </div>

                <t t-else="">
                    <t t-set="years" t-value="visibleYears"/>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="o_hp_search input-group input-group-sm">
                            <span class="input-group-text"><i class="fa fa-search"/></span>
                            <input type="text" class="form-control" t-model="state.search"
                                   placeholder="Pesquisar artigo (código ou descrição)…"/>
                            <button t-if="state.search" class="btn btn-outline-secondary" title="Limpar pesquisa"
                                    t-on-click="clearSearch"><i class="fa fa-times"/></button>
                        </div>
                        <span t-if="query" class="small text-muted me-auto">
                            <t t-esc="searchCount"/> documento(s) com este artigo
                        </span>
                        <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-link p-0" t-on-click="() => this.setAllInvoices(true)">
                            <i class="fa fa-plus-square-o me-1"/>Expandir todos os documentos
                        </button>
                        <span class="text-muted">|</span>
                        <button class="btn btn-sm btn-link p-0" t-on-click="() => this.setAllInvoices(false)">
                            <i class="fa fa-minus-square-o me-1"/>Recolher documentos
                        </button>
                        </div>
                    </div>

                    <div class="o_list_renderer table-responsive">
                        <table class="o_list_table table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th class="o_hp_date">Data</th>
                                    <th class="text-end o_hp_amount">Total sem IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="years" t-as="year" t-key="year.year">
                                    <t t-set="yearOpen" t-value="isYearOpen(year.year)"/>
                                    <tr class="o_group_header o_hp_year" t-att-class="{ o_group_open: yearOpen }"
                                        t-on-click="() => this.toggleYear(year.year)">
                                        <th class="o_group_name" colspan="2">
                                            <i t-attf-class="fa fa-fw me-1 {{ yearOpen ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                                            <t t-esc="year.year"/>
                                            <t t-if="year.filtered">
                                                <span class="text-muted fw-normal ms-1">(<t t-esc="year.invoices.length"/> de <t t-esc="year.count"/>)</span>
                                                <span class="text-muted fw-normal ms-3">valor das linhas encontradas
                                                    <span class="fw-semibold text-body" t-esc="year.foundTotal"/></span>
                                            </t>
                                            <span t-else="" class="text-muted fw-normal ms-1">(<t t-esc="year.count"/>)</span>
                                            <span t-if="year.count_credits and !year.filtered" class="o_hp_year_split text-muted fw-normal ms-3">
                                                <t t-esc="year.count_invoices"/> faturas <t t-esc="year.total_invoices"/>
                                                · <t t-esc="year.count_credits"/> notas de crédito
                                                <span class="text-danger" t-esc="year.total_credits"/>
                                            </span>
                                        </th>
                                        <th class="text-end text-nowrap" t-esc="year.total"/>
                                    </tr>
                                    <t t-if="yearOpen">
                                        <tr t-if="!year.invoices.length" class="o_hp_empty">
                                            <td colspan="3" class="text-muted ps-5 fst-italic">
                                                <t t-if="year.filtered">Sem documentos com este artigo neste ano.</t>
                                                <t t-else="">Sem documentos neste ano.</t>
                                            </td>
                                        </tr>
                                        <t t-foreach="year.invoices" t-as="inv" t-key="inv.id">
                                            <t t-set="invOpen" t-value="state.openInvoices[inv.id]"/>
                                            <tr class="o_data_row o_hp_invoice" t-att-class="{ o_hp_open: invOpen }"
                                                t-on-click="() => this.toggleInvoice(inv.id)">
                                                <td class="ps-4">
                                                    <i t-attf-class="fa fa-fw me-1 text-muted {{ invOpen ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                                                    <span class="fw-semibold" t-esc="inv.name"/>
                                                    <span t-if="inv.is_credit" class="badge rounded-pill text-bg-danger ms-2">Nota de Crédito</span>
                                                    <span t-if="inv.currency_note" class="badge text-bg-warning ms-2" t-esc="inv.currency_note"/>
                                                    <span t-if="year.filtered" class="badge rounded-pill text-bg-warning ms-2"
                                                          title="Linhas deste documento com o artigo pesquisado">
                                                        <t t-esc="matchCount(inv)"/> linha(s)
                                                    </span>
                                                </td>
                                                <td t-esc="inv.date"/>
                                                <td class="text-end text-nowrap" t-att-class="{ 'text-danger': inv.is_credit }">
                                                    <i t-if="!inv.lines_ok" class="fa fa-exclamation-triangle text-warning me-1"
                                                       title="A soma das linhas não coincide com o total da fatura"/>
                                                    <t t-esc="inv.amount"/>
                                                </td>
                                            </tr>
                                            <tr t-if="invOpen" class="o_hp_lines_row">
                                                <td colspan="3" class="p-0">
                                                    <div class="o_hp_lines">
                                                        <table class="table table-sm mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Artigo</th>
                                                                    <th>Descrição</th>
                                                                    <th class="text-end">Qtd.</th>
                                                                    <th>Un.</th>
                                                                    <th class="text-end" title="Preço unitário sem IVA, antes de descontos">Preço unit. s/ IVA<br/><span class="fw-normal text-muted">(antes desc.)</span></th>
                                                                    <th class="text-end">Desconto</th>
                                                                    <th class="text-end" title="Valor da linha sem IVA, depois de todos os descontos">Valor líquido s/ IVA</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr t-foreach="inv.lines" t-as="line" t-key="line.id"
                                                                    t-att-class="{ o_hp_match: lineMatches(line) }">
                                                                    <td class="text-nowrap" t-esc="line.code"/>
                                                                    <td t-esc="line.description"/>
                                                                    <td class="text-end text-nowrap" t-esc="line.quantity"/>
                                                                    <td t-esc="line.uom"/>
                                                                    <td class="text-end text-nowrap" t-esc="line.price_unit"/>
                                                                    <td class="text-end text-nowrap" t-att-title="line.discount_amount and ('Desconto: ' + line.discount_amount)">
                                                                        <t t-if="line.discount" t-esc="line.discount"/>
                                                                        <span t-else="" class="text-muted">—</span>
                                                                    </td>
                                                                    <td class="text-end text-nowrap fw-semibold" t-att-class="{ 'text-danger': line.negative }" t-esc="line.amount"/>
                                                                </tr>
                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <td colspan="6" class="text-end text-muted">
                                                                        <i t-if="inv.lines_ok" class="fa fa-check text-success me-1"
                                                                           title="A soma das linhas confere com o total sem IVA da fatura"/>
                                                                        Soma das linhas
                                                                    </td>
                                                                    <td class="text-end text-nowrap fw-bold" t-att-class="{ 'text-danger': inv.is_credit }" t-esc="inv.lines_total"/>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- Resumo de Compras por Artigo (calculado no servidor a partir das mesmas linhas) -->
                    <t t-set="resumo" t-value="summary"/>
                    <div class="o_hp_summary mt-4">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                            <h5 class="mb-0"><i class="fa fa-cubes me-2 text-muted"/>Resumo de Compras por Artigo</h5>
                            <div class="btn-group btn-group-sm" role="group">
                                <t t-foreach="data.years" t-as="y" t-key="y.year">
                                    <button type="button" class="btn"
                                            t-att-class="state.summaryYear === y.year ? 'btn-primary' : 'btn-outline-primary'"
                                            t-on-click="() => this.setSummaryYear(y.year)" t-esc="y.year"/>
                                </t>
                            </div>
                        </div>
                        <div class="small text-muted mb-2">
                            Quantidades e valores líquidos sem IVA, com descontos e já deduzidas as notas de crédito.
                            Ordenado por valor. Um artigo vendido em unidades diferentes aparece em linhas separadas.
                        </div>
                        <div t-if="!resumo.articles.length and !resumo.charges.length" class="text-muted fst-italic py-2">
                            Sem compras em <t t-esc="state.summaryYear"/>.
                        </div>
                        <t t-else="">
                            <div class="o_list_renderer table-responsive">
                                <table class="o_list_table table table-sm table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Artigo</th>
                                            <th>Descrição</th>
                                            <th class="text-end">Qtd. líquida</th>
                                            <th>Un.</th>
                                            <th class="text-end o_hp_amount">Valor líquido s/ IVA</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="resumo.articles" t-as="a" t-key="a.key">
                                            <td class="text-nowrap" t-esc="a.code"/>
                                            <td>
                                                <t t-esc="a.description"/>
                                                <i t-if="a.split_uom" class="fa fa-info-circle text-muted ms-1"
                                                   title="Este artigo também foi vendido noutra unidade: aparece numa linha separada"/>
                                            </td>
                                            <td class="text-end text-nowrap" t-esc="a.quantity"/>
                                            <td t-esc="a.uom"/>
                                            <td class="text-end text-nowrap fw-semibold" t-att-class="{ 'text-danger': a.negative }" t-esc="a.amount"/>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr class="fw-bold">
                                            <td colspan="4" class="text-end">Total artigos (<t t-esc="resumo.articles.length"/>)</td>
                                            <td class="text-end text-nowrap" t-esc="resumo.total_articles"/>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <t t-if="resumo.charges.length">
                                <h6 class="mt-3 mb-2 text-muted">Portes, serviços e outros (fora do resumo de artigos)</h6>
                                <div class="o_list_renderer table-responsive">
                                    <table class="o_list_table table table-sm table-hover mb-0">
                                        <thead>
                                            <tr>
                                                <th>Código</th>
                                                <th>Descrição</th>
                                                <th class="text-end">N.º linhas</th>
                                                <th class="text-end o_hp_amount">Valor líquido s/ IVA</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="resumo.charges" t-as="e" t-key="e.key">
                                                <td class="text-nowrap" t-esc="e.code or '—'"/>
                                                <td t-esc="e.description"/>
                                                <td class="text-end" t-esc="e.count"/>
                                                <td class="text-end text-nowrap fw-semibold" t-att-class="{ 'text-danger': e.negative }" t-esc="e.amount"/>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr class="fw-bold">
                                                <td colspan="3" class="text-end">Total portes, serviços e outros</td>
                                                <td class="text-end text-nowrap" t-esc="resumo.total_charges"/>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </t>
                            <div class="d-flex justify-content-end gap-3 mt-2 pe-2 fw-bold">
                                <span>Total líquido de <t t-esc="state.summaryYear"/></span>
                                <span class="text-nowrap" t-esc="resumo.total"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>

</templates>
