<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mirazeite_crm_historico_primavera.Historico">
        <div class="o_historico_primavera">
            <t t-set="data" t-value="state.data"/>

            <div t-if="state.loading" class="text-center text-muted py-5">
                <i class="fa fa-circle-o-notch fa-spin me-2"/>A consultar o Primavera…
            </div>

            <div t-elif="data.error" class="alert alert-warning mb-0" role="alert">
                <i class="fa fa-exclamation-triangle me-2"/><t t-esc="data.error"/>
            </div>

            <t t-else="">
                <!-- Cliente e critérios -->
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <div class="fs-5 fw-bold">
                            <span class="badge text-bg-light border me-2" t-esc="data.customer.code"/>
                            <t t-esc="data.customer.name"/>
                        </div>
                        <div class="small text-muted mt-1">
                            <span t-if="data.customer.vat" class="me-3">NIF <t t-esc="data.customer.vat"/></span>
                            <span t-if="data.customer.nif_validated" class="text-success me-3"
                                  title="O NIF da ficha do Odoo é igual ao NIF do cliente no Primavera">
                                <i class="fa fa-check-circle me-1"/>Correspondência validada por NIF
                            </span>
                            <span t-else="" class="text-warning me-3"
                                  title="Um dos lados não tem NIF válido: a correspondência é só pelo código Primavera">
                                <i class="fa fa-info-circle me-1"/>Correspondência só pelo código
                            </span>
                            <span t-if="data.customer.archived" class="badge text-bg-secondary">Cliente anulado no Primavera</span>
                        </div>
                    </div>
                    <div class="text-end small text-muted">
                        <div><t t-esc="data.period"/> · valores sem IVA · anulados excluídos</div>
                        <div>Faturas <t t-esc="data.doc_types"/> · Notas de crédito <t t-esc="data.credit_types"/></div>
                    </div>
                </div>

                <div t-if="!data.count" class="alert alert-info mb-0">
                    <i class="fa fa-info-circle me-2"/>Sem faturas nem notas de crédito no período.
                </div>

                <t t-else="">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <div class="o_hp_picker_wrap position-relative">
                            <button class="btn btn-sm btn-primary" t-on-click="togglePicker">
                                <i class="fa fa-search me-1"/>Pesquisar Artigo
                            </button>
                            <button t-if="state.article" class="btn btn-sm btn-secondary ms-2" t-on-click="backToHistory">
                                <i class="fa fa-arrow-left me-1"/>Voltar ao histórico completo
                            </button>
                            <ArtigoPicker t-if="state.pickerOpen" articles="articles"
                                          onSelect.bind="selectArticle" onClose.bind="togglePicker"/>
                        </div>
                        <div t-if="!state.article" class="d-flex gap-2">
                            <button class="btn btn-sm btn-link p-0" t-on-click="() => this.setAllInvoices(true)">
                                <i class="fa fa-plus-square-o me-1"/>Expandir todos os documentos
                            </button>
                            <span class="text-muted">|</span>
                            <button class="btn btn-sm btn-link p-0" t-on-click="() => this.setAllInvoices(false)">
                                <i class="fa fa-minus-square-o me-1"/>Recolher documentos
                            </button>
                        </div>
                    </div>

                    <!-- Histórico de vendas de um artigo (consulta sobre os dados já carregados) -->
                    <t t-if="state.article" t-call="mirazeite_crm_historico_primavera.ArtigoMovimentos"/>

                    <div t-else="" class="o_list_renderer table-responsive">
                        <table class="o_list_table table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Documento</th>
                                    <th class="o_hp_date">Data</th>
                                    <th class="text-end o_hp_amount">Total sem IVA</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data.years" t-as="year" t-key="year.year">
                                    <t t-set="yearOpen" t-value="isYearOpen(year.year)"/>
                                    <tr class="o_group_header o_hp_year" t-att-class="{ o_group_open: yearOpen }"
                                        t-on-click="() => this.toggleYear(year.year)">
                                        <th class="o_group_name" colspan="2">
                                            <i t-attf-class="fa fa-fw me-1 {{ yearOpen ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                                            <t t-esc="year.year"/>
                                            <span class="text-muted fw-normal ms-1">(<t t-esc="year.count"/>)</span>
                                            <span t-if="year.count_credits" class="o_hp_year_split text-muted fw-normal ms-3">
                                                <t t-esc="year.count_invoices"/> faturas <t t-esc="year.total_invoices"/>
                                                · <t t-esc="year.count_credits"/> notas de crédito
                                                <span class="text-danger" t-esc="year.total_credits"/>
                                            </span>
                                        </th>
                                        <th class="text-end text-nowrap" t-esc="year.total"/>
                                    </tr>
                                    <t t-if="yearOpen">
                                        <tr t-if="!year.count" class="o_hp_empty">
                                            <td colspan="3" class="text-muted ps-5 fst-italic">Sem documentos neste ano.</td>
                                        </tr>
                                        <t t-foreach="year.invoices" t-as="inv" t-key="inv.id">
                                            <t t-set="invOpen" t-value="state.openInvoices[inv.id]"/>
                                            <tr class="o_data_row o_hp_invoice" t-att-class="{ o_hp_open: invOpen }"
                                                t-on-click="() => this.toggleInvoice(inv.id)">
                                                <td class="ps-4">
                                                    <i t-attf-class="fa fa-fw me-1 text-muted {{ invOpen ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                                                    <span class="fw-semibold" t-esc="inv.name"/>
                                                    <span t-if="inv.is_credit" class="badge rounded-pill text-bg-danger ms-2">Nota de Crédito</span>
                                                    <span t-if="inv.currency_note" class="badge text-bg-warning ms-2" t-esc="inv.currency_note"/>
                                                </td>
                                                <td t-esc="inv.date"/>
                                                <td class="text-end text-nowrap" t-att-class="{ 'text-danger': inv.is_credit }">
                                                    <i t-if="!inv.lines_ok" class="fa fa-exclamation-triangle text-warning me-1"
                                                       title="A soma das linhas não coincide com o total da fatura"/>
                                                    <t t-esc="inv.amount"/>
                                                </td>
                                            </tr>
                                            <tr t-if="invOpen" class="o_hp_lines_row">
                                                <td colspan="3" class="p-0">
                                                    <div class="o_hp_lines">
                                                        <table class="table table-sm mb-0">
                                                            <thead>
                                                                <tr>
                                                                    <th>Artigo</th>
                                                                    <th>Descrição</th>
                                                                    <th class="text-end">Qtd.</th>
                                                                    <th>Un.</th>
                                                                    <th class="text-end" title="Preço unitário sem IVA, antes de descontos">Preço unit. s/ IVA<br/><span class="fw-normal text-muted">(antes desc.)</span></th>
                                                                    <th class="text-end">Desconto</th>
                                                                    <th class="text-end" title="Valor da linha sem IVA, depois de todos os descontos">Valor líquido s/ IVA</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                <tr t-foreach="inv.lines" t-as="line" t-key="line.id">
                                                                    <td class="text-nowrap" t-esc="line.code"/>
                                                                    <td t-esc="line.description"/>
                                                                    <td class="text-end text-nowrap" t-esc="line.quantity"/>
                                                                    <td t-esc="line.uom"/>
                                                                    <td class="text-end text-nowrap" t-esc="line.price_unit"/>
                                                                    <td class="text-end text-nowrap" t-att-title="line.discount_amount and ('Desconto: ' + line.discount_amount)">
                                                                        <t t-if="line.discount" t-esc="line.discount"/>
                                                                        <span t-else="" class="text-muted">—</span>
                                                                    </td>
                                                                    <td class="text-end text-nowrap fw-semibold" t-att-class="{ 'text-danger': line.negative }" t-esc="line.amount"/>
                                                                </tr>
                                                            </tbody>
                                                            <tfoot>
                                                                <tr>
                                                                    <td colspan="6" class="text-end text-muted">
                                                                        <i t-if="inv.lines_ok" class="fa fa-check text-success me-1"
                                                                           title="A soma das linhas confere com o total sem IVA da fatura"/>
                                                                        Soma das linhas
                                                                    </td>
                                                                    <td class="text-end text-nowrap fw-bold" t-att-class="{ 'text-danger': inv.is_credit }" t-esc="inv.lines_total"/>
                                                                </tr>
                                                            </tfoot>
                                                        </table>
                                                    </div>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <t t-call="mirazeite_crm_historico_primavera.ResumoArtigos"/>
                </t>
            </t>
        </div>
    </t>

    <!-- Lista de artigos com pesquisa -->
    <t t-name="mirazeite_crm_historico_primavera.ArtigoPicker">
        <div class="o_hp_picker border rounded shadow p-0" t-on-keydown="onKeydown">
            <div class="p-2 border-bottom">
                <input type="text" class="form-control form-control-sm" t-ref="autofocus" t-model="state.query"
                       placeholder="Código ou descrição do artigo…"/>
            </div>
            <div class="o_hp_picker_list">
                <t t-set="list" t-value="filtered"/>
                <button t-foreach="list" t-as="a" t-key="a.code" type="button"
                        class="dropdown-item d-flex gap-2 px-3 py-1" t-on-click="() => this.props.onSelect(a.code)">
                    <span class="o_hp_picker_code text-nowrap fw-semibold" t-esc="a.code"/>
                    <span class="text-truncate" t-esc="a.name"/>
                </button>
                <div t-if="!list.length" class="dropdown-item-text text-muted fst-italic">Nenhum artigo encontrado.</div>
            </div>
            <div class="px-2 py-1 border-top small text-muted">
                <t t-esc="list.length"/> de <t t-esc="props.articles.length"/> artigos vendidos ao cliente
            </div>
        </div>
    </t>

    <!-- Movimentos do artigo seleccionado -->
    <t t-name="mirazeite_crm_historico_primavera.ArtigoMovimentos">
        <t t-set="art" t-value="selectedArticle"/>
        <t t-set="movs" t-value="movements"/>
        <div class="o_hp_article">
            <div class="fs-6 mb-2">
                <span class="badge text-bg-light border me-2" t-esc="art.code"/>
                <span class="fw-semibold" t-esc="art.name"/>
                <span class="text-muted small ms-2">— <t t-esc="movs.length"/> movimento(s), do mais recente para o mais antigo</span>
            </div>
            <div class="o_list_renderer table-responsive">
                <table class="o_list_table table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="o_hp_date">Data</th>
                            <th>Documento</th>
                            <th class="text-end">Quantidade</th>
                            <th>Un.</th>
                            <th class="text-end" title="Valor líquido da linha a dividir pela quantidade: sem IVA, depois do desconto de linha e do desconto global">
                                Preço unit. líquido s/ IVA<br/><span class="fw-normal text-muted">(após descontos)</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="movs" t-as="m" t-key="m.key">
                            <td t-esc="m.inv.date"/>
                            <td>
                                <span class="fw-semibold" t-esc="m.inv.name"/>
                                <span t-if="m.inv.is_credit" class="badge rounded-pill text-bg-danger ms-2">Nota de Crédito</span>
                            </td>
                            <td class="text-end text-nowrap" t-att-class="{ 'text-danger': m.inv.is_credit }" t-esc="m.line.quantity"/>
                            <td t-esc="m.line.uom"/>
                            <td class="text-end text-nowrap" t-att-title="m.line.discount and ('Preço antes de descontos ' + m.line.price_unit + ' · desconto ' + m.line.discount)">
                                <t t-esc="m.line.net_price"/>
                                <i t-if="m.line.discount" class="fa fa-tag text-muted ms-1"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

    <!-- Resumo de Compras por Artigo: quantidades líquidas, ano anterior | ano atual -->
    <t t-name="mirazeite_crm_historico_primavera.ResumoArtigos">
        <t t-set="resumo" t-value="data.summary"/>
        <div class="o_hp_summary mt-4">
            <h5 class="mb-1"><i class="fa fa-cubes me-2 text-muted"/>Resumo de Compras por Artigo</h5>
            <div class="small text-muted mb-2">
                Quantidades líquidas vendidas (notas de crédito deduzidas), na unidade de venda. Ordenado por
                <t t-esc="resumo.year_cur"/>. Um artigo vendido em unidades diferentes aparece em linhas separadas.
                Portes, serviços e outros encargos não entram neste resumo.
            </div>
            <div t-if="!resumo.rows.length" class="text-muted fst-italic py-2">Sem artigos vendidos no período.</div>
            <div t-else="" class="o_list_renderer table-responsive">
                <table class="o_list_table table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Artigo</th>
                            <th>Descrição</th>
                            <th class="text-end o_hp_qty"><t t-esc="resumo.year_prev"/> (unidades)</th>
                            <th class="text-end o_hp_qty"><t t-esc="resumo.year_cur"/> (unidades)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="resumo.rows" t-as="r" t-key="r.key">
                            <td class="text-nowrap" t-esc="r.code"/>
                            <td>
                                <t t-esc="r.description"/>
                                <i t-if="r.split_uom" class="fa fa-info-circle text-muted ms-1"
                                   title="Este artigo também foi vendido noutra unidade: aparece numa linha separada"/>
                            </td>
                            <td class="text-end text-nowrap" t-att-class="{ 'text-muted': r.zero_prev }">
                                <t t-esc="r.q_prev"/> <span class="text-muted small" t-esc="r.uom"/>
                            </td>
                            <td class="text-end text-nowrap fw-semibold" t-att-class="{ 'text-muted fw-normal': r.zero_cur }">
                                <t t-esc="r.q_cur"/> <span class="text-muted small fw-normal" t-esc="r.uom"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </t>

</templates>
